{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ES6",
    "outDir": "./bazar/static/js/compiled",
    "rootDir": "./bazar/static/js/src",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "ES2017"]
  },
  "include": [
    "bazar/static/js/src/**/*"
  ]
}